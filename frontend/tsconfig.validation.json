{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": ["./*"],
      "next/*": ["./node_modules/next/*"],
      "@funkspace/common/tokens/colors": ["../common/generated/colors.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../e2e/**/*.ts",
    "../e2e/**/*.tsx",
    "../playwright*.ts",
    "../vitest-env.d.ts"
  ],
  "exclude": ["node_modules", ".next", "storybook-static"]
}
