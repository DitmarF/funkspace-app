{
  "name": "@funkspace/wave-survivor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "pnpm build && vite demo --host localhost --port 5173 --strictPort",
    "demo:build": "pnpm build && vite build demo",
    "demo:preview": "vite preview demo",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5",
    "vite": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
