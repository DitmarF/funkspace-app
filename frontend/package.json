{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @funkspace/wave-survivor build && next dev -p 3000",
    "build": "pnpm --filter @funkspace/wave-survivor build && next build",
    "start": "next start",
    "lint": "next lint",
    "build:tokens": "pnpm --workspace-root build:tokens",
    "storybook": "pnpm -F frontend build:tokens && storybook dev -p 6006",
    "storybook:build": "pnpm -F frontend build:tokens && storybook build"
  },
  "dependencies": {
    "@funkspace/common": "workspace:*",
    "@funkspace/wave-survivor": "workspace:*",
    "framer-motion": "12.43.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/eslintrc": "3.3.7",
    "@next/eslint-plugin-next": "15.5.24",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@storybook/react": "10.5.10",
    "@types/node": "20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "10.6.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.28",
    "storybook": "10.5.10",
    "storybook-design-token": "^4.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
