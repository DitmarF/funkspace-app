{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/"],
      "startServerCommand": "NEXT_PUBLIC_ANIMATIONS_ENABLED=true pnpm -F frontend start -p 3000",
      "startServerReadyPattern": "Ready in",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "devtools",
        "throttling": {
          "requestLatencyMs": 150,
          "downloadThroughputKbps": 9216,
          "uploadThroughputKbps": 9216
        }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 5000, "aggregationMethod": "p75" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.1, "aggregationMethod": "p75" }
        ],

        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouse/reports/on"
    }
  }
}
