{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:tokens": "pnpm --workspace-root build:tokens",
    "storybook": "pnpm -F frontend build:tokens && storybook dev -p 6006",
    "storybook:build": "pnpm -F frontend build:tokens && storybook build"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "next": "15.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.2",
    "@eslint/eslintrc": "^3",
    "@storybook/addon-a11y": "^10.0.3",
    "@storybook/addon-docs": "^10.0.3",
    "@storybook/addon-themes": "^10.0.3",
    "@storybook/nextjs-vite": "^10.0.3",
    "@storybook/react": "^10.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "postcss": "^8.5.6",
    "storybook": "^10.0.6",
    "storybook-design-token": "^4.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
