{
  "name": "funkspace-app",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "backend",
    "common",
    "games/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm --filter frontend exec next lint --max-warnings=0 && prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:ui": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:smoke": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test e2e/home.a11y.spec.ts",
    "postinstall": "if [ \"$VERCEL\" != \"1\" ]; then cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium --with-deps; fi",
    "build": "pnpm -F @funkspace/common typecheck && pnpm -F frontend build",
    "build:tokens": "pnpm exec style-dictionary build --config style-dictionary.config.mjs",
    "format": "prettier --write .",
    "storybook": "pnpm --filter frontend run storybook",
    "storybook:build": "pnpm --filter frontend run storybook:build",
    "lhci:build": "pnpm build:tokens && pnpm build",
    "lhci:off": "pnpm run lhci:build && lhci autorun --config=.lighthouse/lighthouserc.off.json",
    "lhci:on": "pnpm run lhci:build && lhci autorun --config=.lighthouse/lighthouserc.on.json",
    "lhci:ci": "pnpm run lhci:off && pnpm run lhci:on"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.53.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "3.2",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "style-dictionary": "^5.1.1",
    "tsx": "^4.23.12",
    "vitest": "^3.2.4"
  }
}
